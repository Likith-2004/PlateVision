# Copy to .env and adjust. Every value below is the default, so an empty .env
# is a valid configuration. Parsed and validated by app/config.py at startup.

# ---- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Auto-reload on code changes. Development only.
RELOAD=false
LOG_LEVEL=info

# Browser origins allowed to call this API. Leave EMPTY unless the UI is served
# from a DIFFERENT origin than this API -- which the Vercel deploy is not, since
# both halves sit behind one domain. Comma-separated.
# "*" is defensible for this service: no auth, no cookies, no private data --
# but it does let any page spend your CPU, and each call costs seconds of it.
CORS_ORIGINS=

# Path prefix for every API route. Empty keeps /health and /detect at the root.
#
# Set to "/api" on Vercel, where a rewrite routes /api/* to the Python service
# and the service receives the ORIGINAL path -- so the routes must actually live
# under /api. It must match the frontend's VITE_API_BASE, or the page loads
# perfectly while every request 404s. See DEPLOYMENT.md.
API_PREFIX=

# ---- Paths -----------------------------------------------------------------
MODEL_PATH=model/best.pt
# Uploads and annotated output live under here.
DATA_DIR=data

# ---- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.webp,.bmp
# Annotated images are disposable; anything older than this is pruned.
# Set to 0 to keep everything (the disk will grow without bound).
# Irrelevant when INLINE_IMAGES=true, since nothing is written.
RETENTION_HOURS=24

# Return the annotated image inline in the JSON response as a data URI, instead
# of writing it to disk and returning a /media/... URL to fetch separately.
#
# Set true on any serverless host. There the filesystem is ephemeral AND
# per-instance, so the browser's follow-up GET can hit an instance that never
# wrote the file -- an image that works most of the time, which is worse than
# one that never does. Costs ~33% base64 overhead on a response that is
# normally well under 1 MB.
INLINE_IMAGES=false

# ---- Detection -------------------------------------------------------------
# How sure YOLO must be that a region IS a number plate.
DETECTION_CONFIDENCE=0.5
# Longest edge fed to the detector; larger images are downscaled first.
MAX_INFERENCE_EDGE=1280

# Margin added around a detected plate before OCR, as a fraction of the box's
# longer side, with a pixel floor. Detector boxes sit tight against the glyphs,
# so a FIXED margin clips the outermost character and silently shortens the
# reading -- "22BH6517A" became "22BH6517". Do not lower these without checking
# that the last character survives.
CROP_PADDING_RATIO=0.06
CROP_PADDING_MIN=8

# ---- OCR -------------------------------------------------------------------
# Which recognition engine to use: paddleocr or easyocr.
# Measured on the sample plates (single pass, identical YOLO crops):
#   easyocr    12.2s load, 1.4-3.1s/plate,   1 of 3 format-valid
#   paddleocr  19.6s load, 0.29-0.41s/plate, 3 of 3 at ~99%
# paddleocr also reads the trailing Bharat-series letter that easyocr drops.
OCR_ENGINE=paddleocr

OCR_LANGUAGES=en
OCR_GPU=false

# PaddleOCR model tier. Leave these alone unless you know why: PaddleOCR 3.x
# otherwise selects server-grade models that measured ~40x slower on CPU
# (13-15s/plate) with no accuracy benefit on plate crops.
PADDLE_DETECTION_MODEL=PP-OCRv5_mobile_det
PADDLE_RECOGNITION_MODEL=PP-OCRv5_mobile_rec

# Where PaddleOCR's weights live. Leave BOTH empty locally: Paddle then uses its
# own ~/.paddlex and downloads what it needs once.
#
# A read-only or ephemeral host needs both set. PaddleOCR ships no weights in
# its pip package -- it downloads ~22MB on first construction, which fails on a
# read-only $HOME and would otherwise repeat on every cold start.
#   PADDLE_MODEL_DIR   read-only copy baked into the build by
#                      scripts/warm_paddle.py (relative paths resolve against
#                      the project root, not the working directory)
#   PADDLE_CACHE_DIR   writable location seeded from it at load time
# On Vercel: PADDLE_MODEL_DIR=.paddlex and PADDLE_CACHE_DIR=/tmp/.paddlex
PADDLE_MODEL_DIR=
PADDLE_CACHE_DIR=

# Floor for accepting OCR text that does NOT match a known Indian plate format.
# Format-valid readings bypass this floor.
OCR_MIN_CONFIDENCE=0.1

# Confidence at which a format-valid reading ends the cascade immediately.
OCR_ACCEPT_CONFIDENCE=0.70

# Preprocessing passes per plate. Pass 1 runs at native resolution and resolves
# clean plates; later passes upscale (~4x the pixels, so ~4x the time) and only
# run when earlier passes fail to produce a format-valid plate.
#   1 = fastest, single native pass
#   3 = default, recovers plates a single pass cannot read
#   5 = every variant, slowest
OCR_MAX_PASSES=3

# Wall-clock ceiling in seconds for OCR of one plate. The first pass always
# runs; escalation stops once this is exceeded. Bounds worst-case latency.
OCR_TIME_BUDGET=4.0

# Passes allowed for /detect/frame, where latency matters more than recall.
OCR_LIVE_MAX_PASSES=1

# ---- Concurrency -----------------------------------------------------------
# Neither YOLO nor EasyOCR is thread-safe and CPU inference does not benefit
# from oversubscription, so model access is serialised regardless.
INFERENCE_WORKERS=1
